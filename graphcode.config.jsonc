// graphcode.config.jsonc — die Betriebs-Config dieses Repos (CR-GC-329).
//
// Hier steht jede Urteilsschwelle GENAU EINMAL. Dieselben Werte treiben die Regeln
// (MT-01/MT-02 im Gate und im Steuerungsraum) und verlassen den Host zusammen mit der
// Kennzahl, ueber die sie urteilen: `graph_metrics` liefert `policy` + `policySource`
// in derselben Antwort wie `modules`. Ein Dashboard, das "71 % / Ziel <= 70 %" zeigt,
// liest beide Zahlen von dort und haelt keinen eigenen Zielwert.
//
// JSONC, nicht JSON: ein stillgelegter Wert traegt seine Begruendung neben sich.
// Fehlt diese Datei, gilt DEFAULT_METRIC_POLICY aus @sigloch/contracts und die
// Antwort sagt das (`policySource: "default"`). Ist sie da und schemawidrig, bricht
// der Start ab — kein stiller Fallback.
{
  "metricPolicy": {
    // MT-01 (Instabilitaet, fanOut / (fanIn + fanOut)) ist unvalidiert: die 0.7 ist
    // gesetzt, nicht gemessen (CR-SM-223, "Validation ... is deferred"). null heisst
    // MESSEN, NICHT URTEILEN — die Zahl steht weiter in jeder Modulzeile von
    // graph_metrics, es entsteht nur kein Verstoss. Auf 0.7 setzen, sobald die
    // Schwelle an echten Modulen kalibriert ist.
    "instability": null,

    // MT-02 (LCOM4 = Zahl unverbundener FUNC-Gruppen je MOD): ab `info` gemeldet,
    // ab `warning` hochgestuft. 4/6 ist das Verhalten vor CR-SM-233.
    "lcom4": { "info": 4, "warning": 6 },

    // CR-01 (kreuzende io-Flows je Modulpaar). Bis CR-SM-236 hatte die Regel keinen
    // Aus-Zustand: JEDES Paar mit >= 1 Kreuzung erzeugte eine info, und die verduennt
    // die arch-Dimension. null legt sie still, die Zahl bleibt in graph_metrics.
    // Die frueher in se-design.md behauptete "<= 8" hatte im Regelcode nie eine
    // Entsprechung — der Startwert ist 3 (= das alte `count > 2`).
    "crossingFlows": { "warning": 3 },

    // FM-03: RPN-Grenze des markierten Uebergangs (CR-SM-229). Seit dort urteilt
    // FM-03 nach Action Priority; diese Zahl greift nur, wo AP keine bestaetigte
    // Invariante hat (also weder S >= 9 noch S == 1). 100 ist Domaenenstandard,
    // aber skalenabhaengig.
    "riskRpn": 100,

    // R-04: Modulgroesse GEGEN Kreuzungen — drei Urteile, drei Werte (CR-SM-236).
    // large: > 12 FUNCs gilt als gross (mit Kreuzungen warning, ohne info).
    // coupled: unter 9 FUNCs sieht die Regel gar nicht hin.
    // crossings: ab 3 Kreuzungen warnt auch ein nur `coupled`-grosses Modul.
    "moduleSize": { "large": 12, "coupled": 8, "crossings": 2 },

    // CR-SM-229: die lizenzierte AIAG-VDA-Tabelle gehoert NICHT in diese Datei —
    // sie ist eingecheckt. null heisst hier nicht "aus", sondern "markierter
    // Uebergang": bestaetigte AP-Invarianten, sonst RPN-Baender. Wer eine Lizenz
    // hat, legt sie nach .graphcode/ap-table.json (gitignored).
    "apTable": null
  },

  // "Ist diese Dimension zu schwach?" — EINE Zahl fuer Fokuswahl und ready-Flag.
  // Bis CR-GC-329 hatte dieselbe Frage zwei Antworten (0.8 in generate.ts, 0.7 in
  // se-steering). Die Konsumenten ziehen nach, sobald CR-SM-235 die Schwelle in
  // computeReadiness zum Parameter ohne Default gemacht hat.
  "focusThreshold": 0.8
}
