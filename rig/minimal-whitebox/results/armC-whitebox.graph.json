{
  "elements": [
    {
      "uid": "SYS-web-app",
      "type": "SYS",
      "name": "Multiuser Web-App",
      "attributes": {},
      "description": "Multiuser-fähige Web-App aus dem graphcode harness: Nutzer melden sich an, autorieren gemeinsam einen governten Systemgraphen über das Apply-Gate, sehen Live-Updates und exportieren den Stand."
    },
    {
      "uid": "UC-login",
      "type": "UC",
      "name": "Login",
      "attributes": {},
      "description": "User authenticates and gains access to the system."
    },
    {
      "uid": "UC-collaborate",
      "type": "UC",
      "name": "Collaborate",
      "attributes": {},
      "description": "Multiple users co-author the governed system graph."
    },
    {
      "uid": "UC-export",
      "type": "UC",
      "name": "Export",
      "attributes": {},
      "description": "User exports the current graph state as a file."
    },
    {
      "uid": "UC-multiuser-collaboration",
      "type": "UC",
      "name": "Multiuser Collaboration",
      "attributes": {},
      "description": "Multiple users co-author the governed system graph in real-time."
    },
    {
      "uid": "UC-multiuser-web-app",
      "type": "UC",
      "name": "Multiuser Web App Collaboration",
      "description": "Users authenticate, collaborate on a governed system graph via the Apply-Gate, see live updates, and export the current state.",
      "attributes": {}
    },
    {
      "uid": "ACTOR-user",
      "type": "ACTOR",
      "name": "User",
      "attributes": {},
      "description": "Endnutzer der Web-App, der sich anmeldet und den Graphen autorisiert."
    },
    {
      "uid": "ACTOR-admin",
      "type": "ACTOR",
      "name": "Admin",
      "attributes": {},
      "description": "Administrator, der Nutzer verwaltet und Systemeinstellungen vornimmt."
    },
    {
      "uid": "FCHAIN-login",
      "type": "FCHAIN",
      "name": "Login Flow",
      "attributes": {},
      "description": "User authenticates and gains access to the system."
    },
    {
      "uid": "FCHAIN-collaborate",
      "type": "FCHAIN",
      "name": "Collaboration Flow",
      "attributes": {},
      "description": "Users collaborate on the governed system graph."
    },
    {
      "uid": "FCHAIN-export",
      "type": "FCHAIN",
      "name": "Export Flow",
      "attributes": {},
      "description": "User exports the current state of the governed graph."
    },
    {
      "uid": "FUNC-authenticate-user",
      "type": "FUNC",
      "name": "Authenticate User",
      "attributes": {},
      "description": "Validate user credentials and issue session token."
    },
    {
      "uid": "FUNC-validate-session",
      "type": "FUNC",
      "name": "Validate Session",
      "attributes": {},
      "description": "Check session token validity for authenticated access."
    },
    {
      "uid": "FUNC-logout-user",
      "type": "FUNC",
      "name": "Logout User",
      "attributes": {},
      "description": "Invalidate session token and end user session."
    },
    {
      "uid": "FUNC-merge-changes",
      "type": "FUNC",
      "name": "Merge Changes",
      "attributes": {},
      "description": "Combine concurrent edits from multiple users into a single graph state."
    },
    {
      "uid": "FUNC-notify-users",
      "type": "FUNC",
      "name": "Notify Users",
      "attributes": {},
      "description": "Send real-time updates to all users about graph changes."
    },
    {
      "uid": "FUNC-export-graph",
      "type": "FUNC",
      "name": "Export Graph",
      "attributes": {},
      "description": "Serialize the current graph state into a portable format."
