{
  "elements": [
    {
      "uid": "SYS-web-app",
      "type": "SYS",
      "name": "Multiuser Web App",
      "attributes": {},
      "description": "Multiuser-fähige Web-App aus dem graphcode harness: Nutzer melden sich an, autorieren gemeinsam einen governten Systemgraphen über das Apply-Gate, sehen Live-Updates und exportieren den Stand."
    },
    {
      "uid": "UC-login",
      "type": "UC",
      "name": "Login",
      "attributes": {},
      "description": "Nutzer melden sich an, autorieren gemeinsam einen governten Systemgraphen über das Apply-Gate, sehen Live-Updates und exportieren den Stand."
    },
    {
      "uid": "UC-collab-edit",
      "type": "UC",
      "name": "Kollaborative Graphbearbeitung",
      "attributes": {},
      "description": "Mehrere Nutzer bearbeiten gleichzeitig den Systemgraphen und sehen Live-Updates."
    },
    {
      "uid": "UC-export",
      "type": "UC",
      "name": "Graph Export",
      "attributes": {},
      "description": "Nutzer exportiert den aktuellen Stand des Graphen als Datei."
    },
    {
      "uid": "UC-multiuser-web-app",
      "type": "UC",
      "name": "Multiuser Web App Usage",
      "attributes": {},
      "description": "Endnutzer nutzen die Multiuser-Web-App über Live-Updates und Export-Funktionen."
    },
    {
      "uid": "UC-multiuser-web-app-fähig",
      "type": "UC",
      "name": "Multiuser Web App Fähigkeit",
      "description": "Nutzer melden sich an, autorisieren gemeinsam einen governten Systemgraphen über das Apply-Gate, sehen Live-Updates und exportieren den Stand.",
      "attributes": {}
    },
    {
      "uid": "ACTOR-admin",
      "type": "ACTOR",
      "name": "Admin",
      "attributes": {},
