{
  "elements": [
    {
      "id": "ACTOR-admin",
      "type": "ACTOR",
      "name": "Admin",
      "description": "Systemadministrator, der Nutzer verwaltet und Systemeinstellungen konfiguriert."
    },
    {
      "id": "ACTOR-guest",
      "type": "ACTOR",
      "name": "Guest",
      "description": "Unangemeldeter Gast, der eingeschränkten Zugriff auf den Systemgraphen hat."
    },
    {
      "id": "ACTOR-user",
      "type": "ACTOR",
      "name": "User",
      "description": "Endnutzer, der sich anmeldet und den Systemgraphen autorisiert."
    },
    {
      "id": "FUNC-data-collect",
      "type": "FUNC",
      "name": "Collect export data",
      "description": "Gather system state and user-specific data for export."
    },
    {
      "id": "FUNC-file-generate",
      "type": "FUNC",
      "name": "Generate export file",
      "description": "Create a downloadable file in the requested format."
    },
    {
      "id": "FUNC-login-authenticate",
      "type": "FUNC",
      "name": "Authenticate credentials",
      "description": "Validate user credentials against the identity provider."
    },
    {
      "id": "FUNC-permission-grant",
      "type": "FUNC",
      "name": "Grant permissions",
      "description": "Apply the authorized permissions to the user session."
    },
    {
      "id": "FUNC-role-check",
      "type": "FUNC",
      "name": "Check user role",
      "description": "Verify the user's role against required permissions."
    },
    {
      "id": "FUNC-session-create",
      "type": "FUNC",
      "name": "Create session token",
      "description": "Issue a JWT session token for authenticated user."
    },
    {
      "id": "REQ-audit-log",
      "type": "REQ",
      "name": "Audit logging",
      "description": "Log all authorization actions for compliance."
    },
    {
      "id": "REQ-auth-timeout",
      "type": "REQ",
      "name": "Authentication timeout",
      "description": "Session must expire after 30 minutes of inactivity."
    },
    {
      "id": "REQ-export-format",
      "type": "REQ",
      "name": "Export format support",
      "description": "Support JSON and CSV export formats."
    },
    {
      "id": "REQ-guest-login",
      "type": "REQ",
      "name": "Guest Login Requirement",
      "description": "Requirement for guest login functionality"
    },
    {
      "id": "REQ-login-requirements",
      "type": "REQ",
      "name": "Login Requirements Requirement",
      "description": "Requirement for login requirements functionality"
    },
    {
      "id": "SYS-webapp",
      "type": "SYS",
      "name": "Multiuser Web-App",
      "description": "Multiuser-fähige Web-App aus dem graphcode harness: Nutzer melden sich an, autorieren gemeinsam einen governten Systemgraphen über das Apply-Gate, sehen Live-Updates und exportieren den Stand."
    },
    {
      "id": "TEST-verify-audit-log",
      "type": "TEST",
      "name": "Verify: Audit logging",
      "description": "Prüfe, ob alle Aktionen im Audit-Log protokolliert werden."
    },
    {
      "id": "TEST-verify-auth-timeout",
      "type": "TEST",
      "name": "Verify: Authentication timeout",
      "description": "Prüfe, ob der Benutzer nach Ablauf der Authentifizierungszeit (z.B. 30 Minuten Inaktivität) automatisch abgemeldet wird und keine weiteren Aktionen mehr durchführen kann."
    },
    {
      "id": "TEST-verify-export-format",
      "type": "TEST",
      "name": "Verify: Export format support",
      "description": "Prüfe, ob der Export in den unterstützten Formaten (z.B. JSON, CSV) korrekt erfolgt und die Datenstruktur den Anforderungen entspricht."
    },
    {
      "id": "TEST-verify-guest-login",
      "type": "TEST",
      "name": "Verify: Guest Login Requirement",
      "description": "Prüfe, ob ein Gastbenutzer ohne Anmeldung auf die öffentlichen Bereiche der Web-App zugreifen kann und keine sensiblen Daten einsehen oder bearbeiten kann."
    },
    {
      "id": "TEST-verify-login-requirements",
      "type": "TEST",
      "name": "Verify: Login Requirements Requirement",
      "description": "Prüfe, ob die Anmeldung mit Benutzername und Passwort erfolgreich ist."
    },
    {
      "id": "UC-authorize",
