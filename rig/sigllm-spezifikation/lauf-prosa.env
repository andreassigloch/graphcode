# rig/sigllm-spezifikation — Lauf 2: PROSAISCHER Auftrag statt strukturierter Projektdefinition.
#
#   cd /Users/andreas/Developer/dev/graphcode
#   set -a && source rig/sigllm-spezifikation/lauf-prosa.env && set +a
#   node rig/greenfield-systemtest/run.mjs
#   RESULTS_FILE=results-sigllm-prosa.json node rig/greenfield-systemtest/report.mjs
#
# WARUM: Lauf 1 bekam die Projektdefinition, und die trug bereits die Systemzerlegung
# (SYS-00…05) und sechs nummerierte Akteure. Der Arm hat sie abgeschrieben statt die
# Systemgrenze zu verhandeln — genau die Arbeit, die den handgefuehrten Lauf ausmachte.
# `material-prosa/auftrag.md` traegt denselben Inhalt OHNE Kennungen, ohne Zerlegungstabelle,
# ohne Akteursliste: was das System koennen muss, woran es scheitern kann, zwei konkrete
# Aufgaben, was nicht dazugehoert, was offen ist. Die Struktur ist damit Teil der Aufgabe.
#
# Werte mit Leerzeichen MUESSEN in Anfuehrungszeichen — `source` ist Shell, kein dotenv.

RIG="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

PROMPT_FILE="$RIG/prompt-prosa.txt"
GOLDEN="$RIG/golden/sigllm-v98.graph.json"
MATERIAL="$RIG/material-prosa"
RESULTS_FILE="results-sigllm-prosa.json"

# Die Saat bleibt EIN SYS-Knoten — ohne ihn gibt graph_next_step auf dem leeren Graphen keine
# Richtung, und Lauf 1 haette dann einen Vorteil. Der Wortlaut kommt aus dem Prosa-Auftrag,
# nicht aus der Projektdefinition und erst recht nicht aus dem Modell.
SEED_UID="SYS-sig-local"
SEED_NAME="SIG Local"
SEED_DESC="Eigene LLM-Rechenkapazitaet im internen Netz, vollstaendig lokal: tagsueber interaktiv bedient, nachts selbstaendig arbeitend, unterwegs lokal."

MATERIAL_HINT="Der Auftrag liegt im Workspace unter ./material/auftrag.md. Er ist der einzige Input — es gibt keinen Quellcode, kein fertiges Modell und keine vorgegebene Zerlegung. Nur der Graph zaehlt."

ARMS="opus5"
RUNS="1"
RUN_TIMEOUT_S="3600"

CHECKLIST="$RIG/golden/anforderungen-auftrag.json"
