# rig/sigllm-spezifikation — Aufruf des generischen Runners mit DIESEM Korpus.
#
#   cd /Users/andreas/Developer/dev/graphcode
#   set -a && source rig/sigllm-spezifikation/lauf.env && set +a
#   node rig/greenfield-systemtest/run.mjs
#   node rig/greenfield-systemtest/report.mjs
#
# Werte mit Leerzeichen MUESSEN in Anfuehrungszeichen — `source` ist Shell, kein dotenv.
#
# Kein lokales Modell: ARMS steht auf dem Frontier-Arm. Wer local dazunehmen will, nimmt
# qwen-35b bzw. qwen38-claude wieder in ARMS auf und setzt LMSTUDIO.

RIG="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

PROMPT_FILE="$RIG/prompt.txt"
GOLDEN="$RIG/golden/sigllm-v98.graph.json"
MATERIAL="$RIG/material"
RESULTS_FILE="results-sigllm.json"

# Das eine Rahmenstueck, das der Mensch setzt — Wortlaut aus der Projektdefinition selbst,
# nicht aus dem spaeteren Modell (sonst bekaeme der Arm das Ergebnis geschenkt).
SEED_UID="SYS-sig-local"
SEED_NAME="SIG Local"
SEED_DESC="Lokale LLM-Compute-Plattform fuer das interne Netz: eine Headless-Runtime, die Nutzer interaktiv bedient und nachts einen Hintergrund-Agentenloop ausfuehrt. Keine Cloud-Abhaengigkeit."

MATERIAL_HINT="Die Projektdefinition liegt im Workspace unter ./material/docs/project/sig-local-projektdefinition.md. Sie ist der einzige Input — es gibt keinen Quellcode und kein fertiges Modell. Nur der Graph zaehlt."

ARMS="opus5"
RUNS="1"
RUN_TIMEOUT_S="3600"
