# rig/sigllm-spezifikation — Probelauf qwen3.8 (Auftraggeber 2026-09-26). EIN Lauf, keine Messreihe.
#
#   cd /Users/andreas/Developer/dev/graphcode
#   set -a && source rig/sigllm-spezifikation/lauf-gcrun-qwen38.env && set +a
#   node rig/greenfield-systemtest/run.mjs
#   RESULTS_FILE=results-sigllm-gcrun-qwen38.json node rig/greenfield-systemtest/report.mjs
#
# FRAGE: Kommt das Spec-Modell des manuellen Tests (test_local/executor-local.sh) im
# UNBEAUFSICHTIGTEN Loop zu Mutationen, oder bricht es ab (stop=length, Timeout)? Bisher lief
# qwen3.8 nur interaktiv. Nicht gegen die gcrun-Reihe (qwen3-coder) vergleichbar — anderes Modell.
#
# Derselbe Weg wie der manuelle Test: ueber das sigllm-Gateway (Token + TLS), nicht direkt an ollama.
# Nicht parallel zu einem anderen Lauf auf derselben ollama-Instanz starten — die Messung waere verfaelscht.

source "$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/lauf-gcrun.env"

SIGLLM_DIR="${SIGLLM_DIR:-/Users/andreas/Developer/prod/sigllm}"
NODE_EXTRA_CA_CERTS="$SIGLLM_DIR/data/tls/sig-llm-ca.crt"

KORPUS="sigllm-gcrun-qwen38"
RESULTS_FILE="results-sigllm-gcrun-qwen38.json"
RUNS="1"
RUN_TIMEOUT_S="10800"   # ~5 min je Runde bei 12 Runden; ein Abbruch verwirft nichts (CR-GC-618)

GCRUN_MODEL="qwen3.8-27b-lms:latest"
GCRUN_BASE_URL="https://127.0.0.1:8080"
GCRUN_API_KEY="$(cat "$SIGLLM_DIR/data/client-token.txt")"
GCRUN_MAX_TOKENS="8192"   # wie executor-local.sh: Denken zaehlt als Ausgabe

