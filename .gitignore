node_modules/
dist/
*.tsbuildinfo
# .graphcode/ is the local workspace (kuzu store, lock, host.sock, EXPORT_PENDING) —
# except target-profile.json (CR-GC-295): project config like .mcp.json, committed.
# `/*` instead of a bare trailing `/` because git cannot re-include below an excluded
# directory; `**/` because a pattern with an inner slash would anchor to the repo root
# and un-ignore nested .graphcode dirs (e.g. rig/*/.graphcode).
**/.graphcode/*
!**/.graphcode/target-profile.json
.DS_Store

# local artifacts (predecessor data dir, vector db, scratch data)
.aimprove/
data/
*.db

# internal process docs — gate-review records stay local. Change-requests (docs/cr/) are
# tracked as of BOK-CR-027: they need a history, and `files:` in package.json never shipped
# docs/ to npm anyway. The design narrative for outsiders lives in README.md +
# docs/articles/ + docs/adr/, the measurements in docs/spikes/.
docs/records/
docs/SPEC.md
docs/RECOMMENDATIONS.md

# generated view that is working state, not repo content (CR-GC-264): it dumps the
# full internal CR prose. `graph_export` still writes all 15 views locally — someone
# using graphcode never sees them (the npm tarball carries no docs), someone
# contributing wants the architecture views, not the change history.
# CR-GC-305: the `docs/views/spec.md` entry is gone with the view itself — an ignore
# rule for a file nothing can generate is a dead path.
docs/views/cr-list.md

# maintainer's full internal guardrails (family governance, bok refs); the public
# CLAUDE.md ships the app-relevant subset. Claude Code auto-loads both locally.
CLAUDE.local.md
docs/views/dashboard.url
